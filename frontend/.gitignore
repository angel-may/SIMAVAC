# --- PYTHON / DJANGO ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
pip-wheel-metadata/
*.sqlite3
db.sqlite3
.env
venv/
ENV/
*.bak
*.log

# --- MIGRATIONS CACHE (solo mantener archivos de schema) ---
**/migrations/__pycache__/
!**/migrations/*.py

# --- FRONTEND (Vue.js / Node.js) ---
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
dist/
dist-ssr/
coverage/
*.local

# --- TESTS ---
/cypress/videos/
/cypress/screenshots/
*.spec.js
*.test.js

# --- LOGS ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS & EDITOR FILES ---
.DS_Store
Thumbs.db
*.sw?
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.tsbuildinfo

# --- PROJECT-SPECIFIC ---
# Backend compiled caches
backend/**/__pycache__/
simavac_core/**/__pycache__/

# Ignore compiled static assets
/staticfiles/
